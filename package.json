{
  "name": "@lwojcik/eslint-config",
  "version": "0.3.0",
  "description": "Opinionated ESLint config for TypeScript projects focused on enforcing functional style and security",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript",
    "functional",
    "security",
    "react",
    "angular",
    "nestjs",
    "llms"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./angular": {
      "types": "./angular.d.ts",
      "default": "./angular.js"
    },
    "./angular/rxjs": {
      "types": "./angular-rxjs.d.ts",
      "default": "./angular-rxjs.js"
    },
    "./tanstack-query": {
      "types": "./tanstack-query.d.ts",
      "default": "./tanstack-query.js"
    },
    "./nestjs": {
      "types": "./nestjs.d.ts",
      "default": "./nestjs.js"
    }
  },
  "files": [
    "index.js",
    "xss-plugin.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "angular.js",
    "angular.d.ts",
    "angular-rxjs.js",
    "angular-rxjs.d.ts",
    "tanstack-query.js",
    "tanstack-query.d.ts",
    "nestjs.js",
    "nestjs.d.ts",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "czg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc",
    "test:coverage": "vitest run --coverage",
    "release": "HUSKY=0 GITHUB_TOKEN=$(gh auth token) release-it --no-increment --no-git.commit",
    "release:prepare": "scripts/release-prepare.sh"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "eslint-plugin-no-pii": "^1.1.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-security-node": "^1.1.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0"
  },
  "devDependencies": {
    "@angular/core": "22.3.0",
    "@angular/router": "22.3.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@darraghor/eslint-plugin-nestjs-typed": "7.5.10",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/testing": "12.6.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tanstack/angular-query": "5.108.4",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/react-query": "5.108.4",
    "@types/node": "26.6.7",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "angular-eslint": "22.8.0",
    "class-validator": "0.15.1",
    "czg": "1.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-rxjs-x": "1.0.7",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "reflect-metadata": "0.2.2",
    "release-it": "^21.1.3",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.0.0",
    "@eslint-react/eslint-plugin": "^5.0.0",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-rxjs-x": "^1.0.0",
    "typescript": ">=5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y-x": {
      "optional": true
    },
    "angular-eslint": {
      "optional": true
    },
    "eslint-plugin-rxjs-x": {
      "optional": true
    },
    "@tanstack/eslint-plugin-query": {
      "optional": true
    },
    "@darraghor/eslint-plugin-nestjs-typed": {
      "optional": true
    }
  }
}
